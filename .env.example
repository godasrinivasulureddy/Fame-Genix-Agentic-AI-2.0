# FAME-GENIX 2.0 — Deployment environment variables
# Copy to .env and fill in real values before `docker compose up --build`.

# Google GenAI (multimodal document/OCR)
GEMINI_API_KEY=your_gemini_api_key_here

# Nebius Token Factory / NVIDIA Nemotron (dual-model inference)
NEBIUS_API_KEY=your_nebius_api_key_here

# Tavily medical-guidelines search (RAG evidence)
TAVILY_API_KEY=your_tavily_api_key_here

# JWT signing secret (CHANGE IN PRODUCTION)
JWT_SECRET=change_me_to_a_strong_random_32_byte_secret

# Allowed CORS origins (comma-separated)
CORS_ALLOW_ORIGINS=http://localhost:3000
