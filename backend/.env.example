ENVIRONMENT=development
SIMULATION_MODE=true

# Leave as sqlite for zero-setup local run. Point to Postgres for closer-to-prod testing:
# DATABASE_URL=postgresql://user:password@localhost:5432/fame_genix
DATABASE_URL=sqlite:///./fame_genix.db

JWT_SECRET=change-me-in-production
ALLOW_QML=false

# Gemini AI Foundation Config
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
AI_ENABLED=true
AI_TIMEOUT_SECONDS=30

# Nebius Token Factory / NVIDIA Model Integration (Optional)
NEBIUS_API_KEY=your_nebius_api_key_here
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.ai/v1
NVIDIA_MODEL=meta/llama-3.1-70b-instruct

# Tavily Medical Guidelines Search (Optional)
TAVILY_API_KEY=your_tavily_api_key_here

