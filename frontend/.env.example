VITE_API_BASE=http://localhost:8000/api/v1
# Demo-profile sign-in (spec: patient@, doctor@, emergency@, ambulance@, admin@). Never commit real values.
VITE_DEMO_DOMAIN=famegenix.org
VITE_DEMO_PASSWORD=
